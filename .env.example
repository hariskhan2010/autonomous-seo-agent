# autonomous-seo-agent — environment template.
# Copy to `.env` and fill real values. NEVER commit `.env`.
# Grouped by the phase that introduces each variable (see A-TO-Z-PLAN.md §V.6).

# ── Phase 0 ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://seo:seo@localhost:5432/seo
DATABASE_URL_MIGRATOR=postgresql+psycopg://seo_migrator:seo@localhost:5432/seo
REDIS_URL=redis://localhost:6379/0

# ── Phase 1 ──────────────────────────────────────────────
# LLM providers — free-tier first (see NEEDED-KEYS.md). Roles map in config/model_registry.yaml.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_REGISTRY_PATH=./config/model_registry.yaml
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
JWT_SECRET=
APP_SECRET_KEY=
WEBHOOK_SIGNING_SECRET=
ENCRYPTION_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
ENV=dev

# ── Phase 2 ──────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=seo-evidence
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# ── Phase 3 ──────────────────────────────────────────────
PAGESPEED_API_KEY=
CRUX_API_KEY=

# ── Phase 4 ──────────────────────────────────────────────
SERPAPI_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
VOYAGE_API_KEY=

# ── Phase 5 ──────────────────────────────────────────────
OPENAI_API_KEY=

# ── Phase 7 ──────────────────────────────────────────────
AHREFS_API_KEY=

# ── Phase 8 ──────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=

# ── Phase 9 ──────────────────────────────────────────────
VERCEL_TOKEN=

# ── Phase 10 ─────────────────────────────────────────────
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ── Phase 11 ─────────────────────────────────────────────
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Celery beat (`make beat` / compose `beat`): comma-separated tenant_uuid:project_uuid pairs that
# get a periodic scheduler.tick + events.relay. Empty = beat schedules nothing.
BEAT_TARGETS=
BEAT_SCHEDULER_TICK_SECONDS=60
BEAT_EVENTS_RELAY_SECONDS=15

# ── Phase 12 ─────────────────────────────────────────────
RESEND_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SECRET_MANAGER_URL=
