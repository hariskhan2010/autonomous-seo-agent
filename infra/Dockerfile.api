# Shared image for api + worker.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev || uv sync --no-dev

COPY packages ./packages
COPY apps ./apps
COPY integrations ./integrations
COPY database ./database
COPY config ./config

ENV PYTHONPATH=/app/packages:/app/apps/api:/app/apps/worker
# Fail closed: a container started without ENV runs as prod (dev auth bypass off, real secrets
# required — common/settings.py). docker-compose sets ENV=dev via .env for local use.
ENV ENV=prod
EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000"]
